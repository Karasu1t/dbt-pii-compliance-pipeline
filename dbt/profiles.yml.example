# Copy this file to ~/.dbt/profiles.yml (or set DBT_PROFILES_DIR to this
# directory) and fill in your own workspace values. Never commit the real
# profiles.yml — it is gitignored.
pii_compliance_pipeline:
  target: dev
  outputs:
    dev:
      type: databricks
      catalog: pii_compliance_dev
      schema: default
      host: "{{ env_var('DATABRICKS_HOST') }}"           # e.g. dbc-xxxxxxxx-xxxx.cloud.databricks.com (no https://)
      http_path: "{{ env_var('DATABRICKS_HTTP_PATH') }}" # SQL warehouse HTTP path
      token: "{{ env_var('DATABRICKS_TOKEN') }}"          # personal access token
      threads: 4
